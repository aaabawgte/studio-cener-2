{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "studio-cener-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "vars": {
    "ENVIRONMENT": "local",
    "AUTH_BASE_URL": "http://localhost:8787",
    "TRUSTED_ORIGINS": "http://localhost:5173",
    "PLATFORM_ADMIN_EMAILS": "admin@example.test"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studio-cener-local",
      "migrations_dir": "../../db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "studio-cener-media"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "2026101601",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "BOOKING_RATE_LIMITER",
      "namespace_id": "2026101602",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOKING_COORDINATOR",
        "class_name": "BookingCoordinator"
      },
      {
        "name": "VALUE_COORDINATOR",
        "class_name": "ValueCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BookingCoordinator"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ValueCoordinator"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
