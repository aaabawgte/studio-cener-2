{
  "name": "studio-cener",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @studio/web",
    "dev:api": "npm run dev --workspace @studio/api",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview --workspace @studio/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.56.1"
  }
}
